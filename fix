-- Check if a remote looks like a weapon remote based on common patterns
local function IsLikelyWeaponRemote(remote)
    if not remote or not remote:IsA("RemoteEvent") and not remote:IsA("RemoteFunction") then
        return false
    end
    
    local name = remote.Name:lower()
    -- Common weapon remote naming patterns
    return name:find("weapon") or 
           name:find("shoot") or 
           name:find("fire") or 
           name:find("hit") or
           name:find("damage") or
           name:find("attack") or
           name:find("slash") or
           name:find("stab") or
           name:find("throw") or
           name:find("knife") or
           name:find("gun")
end

-- Check if arguments look like weapon fire data (position/direction based)
local function IsWeaponFireData(args)
    if #args == 0 then return false end
    
    -- Weapon fires usually have CFrame, Vector3, or BasePart as first few args
    for i = 1, math.min(3, #args) do
        local arg = args[i]
        if typeof(arg) == "CFrame" or typeof(arg) == "Vector3" then
            return true
        end
        if typeof(arg) == "Instance" and arg:IsA("BasePart") then
            return true
        end
    end
    return false
end

-- Get closest player function
local function GetClosestPlayer(maxDistance)
    local closestPlayer = nil
    local shortestDistance = math.huge
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Humanoid") then
            if player.Character.Humanoid.Health > 0 then
                if not Settings.TeamCheck or player.Team ~= LocalPlayer.Team then
                    local head = player.Character:FindFirstChild("Head")
                    local rootPart = player.Character:FindFirstChild("HumanoidRootPart")
                    local targetPart = head or rootPart
                    
                    if targetPart then
                        local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                        if onScreen then
                            local distance = (Vector2.new(Mouse.X, Mouse.Y) - Vector2.new(screenPos.X, screenPos.Y)).Magnitude
                            if distance < shortestDistance and distance <= maxDistance then
                                if not Settings.WallCheck then
                                    shortestDistance = distance
                                    closestPlayer = player
                                else
                                    local rayParams = RaycastParams.new()
                                    rayParams.FilterDescendantsInstances = {LocalPlayer.Character}
                                    rayParams.FilterType = Enum.RaycastFilterType.Blacklist
                                    local ray = Workspace:Raycast(Camera.CFrame.Position, (targetPart.Position - Camera.CFrame.Position).Unit * 1000, rayParams)
                                    if not ray or (ray.Instance and ray.Instance:IsDescendantOf(player.Character)) then
                                        shortestDistance = distance
                                        closestPlayer = player
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    
    return closestPlayer
end

-- ========== SILENT AIM HOOK ==========
local function InstallSilentAimHook()
    if SilentAimHookInstalled then return end
    if not (hookmetamethod and getnamecallmethod) then return end
    
    OriginalNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
        local args = {...}
        local method = getnamecallmethod()
        
        -- CRITICAL: If Silent Aim is disabled, pass through immediately without touching anything
        if not Settings.SilentAim then
            return OriginalNamecall(self, ...)
        end
        
        -- Only process FireServer/InvokeServer
        if method ~= "FireServer" and method ~= "InvokeServer" then
            return OriginalNamecall(self, ...)
        end
        
        -- Only process likely weapon remotes
        if not IsLikelyWeaponRemote(self) then
            return OriginalNamecall(self, ...)
        end
        
        -- Only process if args look like weapon fire data
        if not IsWeaponFireData(args) then
            return OriginalNamecall(self, ...)
        end
        
        -- Now we can safely assume this is a weapon fire
        local target = GetClosestPlayer(Settings.SilentAimFOV)
        if target and target.Character then
            local head = target.Character:FindFirstChild("Head")
            local rootPart = target.Character:FindFirstChild("HumanoidRootPart")
            local aimPos = head and head.Position or (rootPart and rootPart.Position)
            
            if aimPos then
                for i, arg in ipairs(args) do
                    if typeof(arg) == "CFrame" then
                        args[i] = CFrame.new(aimPos)
                    elseif typeof(arg) == "Vector3" then
                        args[i] = aimPos
                    elseif typeof(arg) == "Instance" and arg:IsA("BasePart") then
                        if not arg:IsDescendantOf(target.Character) then
                            args[i] = head or rootPart
                        end
                    end
                end
            end
        end
        
        return OriginalNamecall(self, unpack(args))
    end))
    
    SilentAimHookInstalled = true
end

