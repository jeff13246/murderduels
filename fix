local function UpdateSpeed()
    local character = LocalPlayer.Character
    if character then
        local humanoid = character:FindFirstChild("Humanoid")
        if humanoid then
            humanoid.WalkSpeed = Settings.SpeedEnabled and Settings.SpeedValue or 16
        end
    end
end

