-- toggle row builder
local function makeToggle(text, getv, setv)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1,0,0,26)
    btn.BackgroundColor3 = Color3.fromRGB(34,34,42)
    btn.AutoButtonColor = true
    btn.Text = ""
    btn.LayoutOrder = nextOrder()
    btn.Parent = frame
    local cc = Instance.new("UICorner"); cc.CornerRadius = UDim.new(0,6); cc.Parent = btn
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1,-44,1,0); lbl.Position = UDim2.fromOffset(8,0)
    lbl.BackgroundTransparency = 1; lbl.Text = text
    lbl.TextColor3 = Color3.fromRGB(210,210,220); lbl.Font = Enum.Font.Gotham; lbl.TextSize = 13
    lbl.TextXAlignment = Enum.TextXAlignment.Left; lbl.Parent = btn
    local pip = Instance.new("TextLabel")
    pip.Size = UDim2.fromOffset(34,18); pip.Position = UDim2.new(1,-40,0.5,-9)
    pip.Font = Enum.Font.GothamBold; pip.TextSize = 11; pip.Parent = btn
    local pc = Instance.new("UICorner"); pc.CornerRadius = UDim.new(0,5); pc.Parent = pip
    local function refresh()
        local on = getv()
        pip.Text = on and "ON" or "OFF"
        pip.BackgroundColor3 = on and Color3.fromRGB(60,170,90) or Color3.fromRGB(80,80,90)
        pip.TextColor3 = Color3.fromRGB(255,255,255)
    end
    btn.MouseButton1Click:Connect(function() setv(not getv()); refresh() end)
    refresh()
    return btn
end

-- number input builder
local function makeInput(text, getv, setv)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1,0,0,26); row.BackgroundTransparency = 1
    row.LayoutOrder = nextOrder(); row.Parent = frame
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1,-70,1,0); lbl.BackgroundTransparency = 1; lbl.Text = text
    lbl.TextColor3 = Color3.fromRGB(210,210,220); lbl.Font = Enum.Font.Gotham; lbl.TextSize = 13
    lbl.TextXAlignment = Enum.TextXAlignment.Left; lbl.Parent = row
    local box = Instance.new("TextBox")
    box.Size = UDim2.fromOffset(62,24); box.Position = UDim2.new(1,-62,0.5,-12)
    box.BackgroundColor3 = Color3.fromRGB(34,34,42)
    box.TextColor3 = Color3.fromRGB(240,240,250); box.Font = Enum.Font.GothamMedium; box.TextSize = 13
    box.Text = tostring(getv()); box.ClearTextOnFocus = false; box.Parent = row
    local bc = Instance.new("UICorner"); bc.CornerRadius = UDim.new(0,6); bc.Parent = box
    box.FocusLost:Connect(function()
        local n = tonumber(box.Text)
        if n then setv(n) else box.Text = tostring(getv()) end
    end)
end

