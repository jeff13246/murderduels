local BP           = plr:WaitForChild("Backpack")

--------------------------------------------------------------------
-- config (these get edited live by the panel; kg, not size)
--------------------------------------------------------------------
local cfg = {
    enabled       = true,
    keepForbidden = true,
    keepSecretKg  = 200,   -- keep any secret over this weight
    keepAnyKg     = 300,   -- keep anything at all over this weight
    doHeart       = true,
}

local function kgToSize(kg) return kg / 10 end   -- weight = size * 10

