-- ============================================================
local cardOpRunning = false

local function deleteCards(setStatus)
	setStatus = setStatus or function() end
	if cardOpRunning then setStatus("Delete already running...") return end
	cardOpRunning = true

	task.spawn(function()
		local ok, err = pcall(function()
			local pg = LocalPlayer:WaitForChild("PlayerGui")
			local sz = pg:FindFirstChild("SiblingZIndex")
			local deck = sz and sz:FindFirstChild("DeckCreator")
			local main = deck and deck:FindFirstChild("Main")
			local Main_Content = main and main:FindFirstChild("Main_Content")
			if not Main_Content then setStatus("Open the card menu first, then click Delete Cards.") return end
			local Cards = Main_Content:FindFirstChild("Cards")
			local DeleteCards = RS.Remotes.Cards.General.DeleteCards
			if not Cards then setStatus("Card grid not found - reopen the menu.") return end

			local function tierOf(t) t=(t or ""):upper()
				if t:find("III") then return 3 elseif t:find("II") then return 2 else return 1 end end
			local function readFrame(c)
				local m=c:FindFirstChild("Main"); if not m then return nil end
				local nl=m:FindFirstChild("Name"); local r=m:FindFirstChild("Rarity")
				local a=nl and nl.Parent:FindFirstChild("Amount"); local cnt=1
				if a and a.Text then local n=tonumber((a.Text:gsub("[^%d]",""))); if n and n>0 then cnt=n end end
				return {name=nl and nl.Text or "?", tier=tierOf(r and r.Text), shiny=m:FindFirstChild("Hidden_Details")~=nil, count=cnt}
			end
			local function vkey(name,shiny) return (name:lower():gsub("^%s+",""):gsub("%s+$","")).."|"..(shiny and "S" or "N") end

			local pageBox
			for _,o in ipairs(Main_Content:GetDescendants()) do
				if o:IsA("TextBox") and (o.Text or ""):match("%d+%s*/%s*%d+") then pageBox=o; break end
			end
			if not pageBox then setStatus("Page box not found - make sure cards are showing.") return end
			local function curPage() return tonumber((pageBox.Text or ""):match("(%d+)")) end
			local function maxPage() return tonumber((pageBox.Text or ""):match("/%s*(%d+)")) end
			local function gotoPage(n)
				for _=1,3 do
					pcall(function()
						pageBox:CaptureFocus(); task.wait(0.08)
						pageBox.Text=tostring(n); task.wait(0.05)
						VIM:SendKeyEvent(true,Enum.KeyCode.Return,false,game); task.wait(0.04)
						VIM:SendKeyEvent(false,Enum.KeyCode.Return,false,game)
						pcall(function() pageBox:ReleaseFocus(true) end)
					end)
					task.wait(0.5)
					if curPage()==n then return true end
				end
				return false
			end

			local mx = maxPage()
			if not mx then setStatus("Couldn't read page count.") return end
			if not gotoPage(1) then setStatus("Couldn't navigate to page 1.") return end

			local store = {}
			for n=1,mx do
				if curPage()~=n then gotoPage(n) end
				task.wait(0.15)
				for _,c in ipairs(Cards:GetChildren()) do
					if c:IsA("Frame") and c.Name~="NormalTemplate" and c.Name~="ShinyTemplate" then
						if not store[c.Name] then local i=readFrame(c); if i then i.uuid=c.Name; store[c.Name]=i end end
					end
				end
				setStatus(("Reading page %d/%d"):format(n,mx))
			end

			local hasT3 = {}
			for _,i in pairs(store) do if i.tier==3 and i.count>=1 then hasT3[vkey(i.name,i.shiny)] = true end end

			local plan, totalFires = {}, 0
			for _,i in pairs(store) do
				local target
				if i.tier==3 then target=1 else target = hasT3[vkey(i.name,i.shiny)] and 0 or i.count end
				local fires = i.count - target
				if fires > 0 then totalFires = totalFires + fires; table.insert(plan,{uuid=i.uuid, name=i.name, fires=fires}) end
			end

			if totalFires == 0 then setStatus("Nothing to delete - already clean.") return end

			local done = 0
			for _,p in ipairs(plan) do
				for _=1,p.fires do
					DeleteCards:FireServer({ p.uuid })
					done = done + 1
					if done % 4 == 0 then setStatus(("Deleting %d/%d"):format(done,totalFires)) end
					task.wait(0.16)
				end
			end
			setStatus(("Done - deleted %d cards. Refresh to verify."):format(totalFires))
			print("[DeleteCards] deleted", totalFires)
		end)
		if not ok then setStatus("Delete error: " .. tostring(err)); warn("[DeleteCards]", err) end
		cardOpRunning = false
	end)
end

