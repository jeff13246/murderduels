        b.MouseButton1Click:Connect(function() cfg[key]=not cfg[key] rf() if onChange then onChange() end end) rf()
    end

    mkLabel(buyTab,"Auto-Buy",UDim2.new(1,0,0,18),UDim2.new(),C.txt,Enum.Font.GothamBold,14) y=22
