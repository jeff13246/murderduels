-- ===== Countdown Settings =====
local COUNTDOWN_SECONDS = 90
local countdownEndsAt = 0
local countdownActiveName = nil
local countdownLabel = nil

local function formatCountdown(seconds)
	seconds = math.max(0, math.ceil(seconds))
	local m = math.floor(seconds / 60)
	local s = seconds % 60
	return string.format("%d:%02d", m, s)
end

local function updateCountdownLabel()
	if not countdownLabel then return end
	if countdownEndsAt <= 0 then countdownLabel.Text = "T --" return end
	local remaining = countdownEndsAt - os.clock()
	if remaining <= 0 then
		countdownEndsAt = 0
		countdownActiveName = nil
		countdownLabel.Text = "T 0:00"
	else
		countdownLabel.Text = "T " .. formatCountdown(remaining)
	end
end

