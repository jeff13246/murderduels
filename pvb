-- ===== Hotkey Helpers =====
local numberNameToDisplay = {Zero="0",One="1",Two="2",Three="3",Four="4",Five="5",Six="6",Seven="7",Eight="8",Nine="9"}
local displayToKeyName = {["0"]="Zero",["1"]="One",["2"]="Two",["3"]="Three",["4"]="Four",["5"]="Five",["6"]="Six",["7"]="Seven",["8"]="Eight",["9"]="Nine"}
local modifierKeyNames = {LeftControl=true,RightControl=true,LeftShift=true,RightShift=true,LeftAlt=true,RightAlt=true}

local keyNamesByLower = {}
local displayNamesByLower = {}
local function displayFromKeyCodeName(name) return numberNameToDisplay[name] or name end
for _, item in ipairs(Enum.KeyCode:GetEnumItems()) do
	local enumName = item.Name
	keyNamesByLower[string.lower(enumName)] = enumName
	displayNamesByLower[string.lower(displayFromKeyCodeName(enumName))] = enumName
end

local keyAliases = {esc="Escape",escape="Escape",enter="Return",returnkey="Return",space="Space",spacebar="Space",del="Delete",delete="Delete",backspace="Backspace",tab="Tab",capslock="CapsLock"}

local function normalizeMainKey(part)
	part = trim(part)
	if part == "" then return nil end
	local lower = string.lower(part)
	if displayToKeyName[part] then return displayFromKeyCodeName(displayToKeyName[part]) end
	if keyAliases[lower] then return displayFromKeyCodeName(keyAliases[lower]) end
	if keyNamesByLower[lower] then return displayFromKeyCodeName(keyNamesByLower[lower]) end
	if displayNamesByLower[lower] then return displayFromKeyCodeName(displayNamesByLower[lower]) end
	return false
end

local function normalizeComboText(text)
	text = trim(text)
	if text == "" then return nil end
	text = text:gsub("%s+", "")
	local parts = {}
	for part in string.gmatch(text, "[^+]+") do table.insert(parts, part) end
	local ctrl, alt, shift, mainKey = false, false, false, nil
	for _, part in ipairs(parts) do
		local lower = string.lower(part)
		if lower=="ctrl" or lower=="control" or lower=="leftcontrol" or lower=="rightcontrol" then ctrl=true
		elseif lower=="alt" or lower=="leftalt" or lower=="rightalt" then alt=true
		elseif lower=="shift" or lower=="leftshift" or lower=="rightshift" then shift=true
		else
			local key = normalizeMainKey(part)
			if key == false then warn("Invalid hotkey key:", part) return false end
			if mainKey then warn("Invalid combo, multiple main keys:", text) return false end
			mainKey = key
		end
	end
	if not mainKey then return false end
	local combo = {}
	if ctrl then table.insert(combo, "Ctrl") end
	if alt then table.insert(combo, "Alt") end
	if shift then table.insert(combo, "Shift") end
	table.insert(combo, mainKey)
	return table.concat(combo, "+")
end

local function isDown(key) return UIS:IsKeyDown(Enum.KeyCode[key]) end

local function comboFromKeyCode(keyCode)
	local keyName = keyCode.Name
	if keyName == "Unknown" then return nil end
	if modifierKeyNames[keyName] then return nil end
	local combo = {}
	if isDown("LeftControl") or isDown("RightControl") then table.insert(combo, "Ctrl") end
	if isDown("LeftAlt") or isDown("RightAlt") then table.insert(combo, "Alt") end
	if isDown("LeftShift") or isDown("RightShift") then table.insert(combo, "Shift") end
	table.insert(combo, displayFromKeyCodeName(keyName))
	return table.concat(combo, "+")
end

-- ===== File Load / Save =====
local function normalizeCoords(tbl)
	if type(tbl) ~= "table" then return {} end
	for name, data in pairs(tbl) do
		if type(data) ~= "table" then tbl[name] = nil
		else
			if not data.pos and tonumber(data[1]) and tonumber(data[2]) and tonumber(data[3]) then
				data = {pos={data[1],data[2],data[3]}, cam=data.cam, tpHotkey=data.tpHotkey or data.hotkey, updHotkey=data.updHotkey, countdownTimer=data.countdownTimer==true, order=data.order}
				tbl[name] = data
			end
			if type(data.pos) ~= "table" then tbl[name] = nil
			else
				if data.hotkey and not data.tpHotkey then data.tpHotkey = data.hotkey end
				data.hotkey = nil
				data.countdownTimer = data.countdownTimer == true
				if data.tpHotkey then local f = normalizeComboText(data.tpHotkey); data.tpHotkey = f ~= false and f or nil end
				if data.updHotkey then local f = normalizeComboText(data.updHotkey); data.updHotkey = f ~= false and f or nil end
			end
		end
	end
	return tbl
end

local function readJsonFile(path)
	if not canWrite then return nil end
	if canFS and not isfile(path) then return nil end
	local ok, data = pcall(readfile, path)
	if not ok or not data or #data == 0 then return nil end
	local success, tbl = pcall(function() return HttpService:JSONDecode(data) end)
	if success and type(tbl) == "table" then return normalizeCoords(tbl) end
	return nil
end

local function loadCoords()
	local tbl = readJsonFile(FILE)
	if not tbl then tbl = readJsonFile(BACKUP_FILE) end
	if tbl then coordsCache = tbl end
	return coordsCache
end

local function saveCoords(tbl)
	if type(tbl) ~= "table" then return false end
	coordsCache = tbl
	if not canWrite then warn("writefile/readfile not supported. Coords are session-only.") return false end
	if canFS and not isfolder(FOLDER) then pcall(makefolder, FOLDER) end
	local ok, json = pcall(function() return HttpService:JSONEncode(tbl) end)
	if not ok then warn("Failed to encode coords.") return false end
	local a = pcall(writefile, FILE, json)
	local b = pcall(writefile, BACKUP_FILE, json)
	return a or b
end

-- ===== Ordering =====
local function getSortedKeys(coords)
	local keys = {}
	for name in pairs(coords) do table.insert(keys, name) end
	table.sort(keys, function(a, b)
		local da, db = coords[a], coords[b]
		local oa = da and da.order
		local ob = db and db.order
		if type(oa)=="number" and type(ob)=="number" and oa~=ob then return oa < ob end
		if type(oa)=="number" and type(ob)~="number" then return true end
		if type(oa)~="number" and type(ob)=="number" then return false end
		return string.lower(a) < string.lower(b)
	end)
	return keys
end

local function applyOrders(coords, keys)
	for i, name in ipairs(keys) do if coords[name] then coords[name].order = i end end
end

local function ensureOrders(coords)
	local keys = getSortedKeys(coords)
	local changed = false
	for i, name in ipairs(keys) do
		if coords[name] and coords[name].order ~= i then coords[name].order = i; changed = true end
	end
	return changed
end

-- ===== Countdown Trigger Helpers =====
local function toggleCountdownTrigger(name)
	local coords = loadCoords()
	local data = coords[name]
	if not data then warn("Coord missing:", name) return false end
	local currentlySelected = data.countdownTimer == true
	for _, o in pairs(coords) do if type(o)=="table" then o.countdownTimer = false end end
	if not currentlySelected then data.countdownTimer = true; print("[Timer] set:", name)
	else print("[Timer] cleared:", name) end
	saveCoords(coords)
	return true
end

local function startCountdownIfNeeded(name)
	local coords = loadCoords()
	local data = coords[name]
	if data and data.countdownTimer == true then
		countdownActiveName = name
		countdownEndsAt = os.clock() + COUNTDOWN_SECONDS
		updateCountdownLabel()
		print("[Timer] started:", name)
	end
end

-- ===== Hotkey Maps =====
local function rebuildHotkeys()
	tpHotkeyMap = {}
	updHotkeyMap = {}
	local coords = loadCoords()
	for name, data in pairs(coords) do
		if type(data) == "table" then
			if data.tpHotkey and data.tpHotkey ~= "" then tpHotkeyMap[data.tpHotkey] = name end
			if data.updHotkey and data.updHotkey ~= "" then updHotkeyMap[data.updHotkey] = name end
		end
	end
end

local function setCoordHotkey(name, field, hotkeyText)
	local coords = loadCoords()
	local data = coords[name]
	if not data then warn("Coord missing:", name) return false end
	local combo = normalizeComboText(hotkeyText)
	if combo == false then return false end
	for _, o in pairs(coords) do
		if type(o) == "table" then
			if o.tpHotkey == combo then o.tpHotkey = nil end
			if o.updHotkey == combo then o.updHotkey = nil end
		end
	end
	data[field] = combo
	saveCoords(coords)
	rebuildHotkeys()
	return true
end

-- ===== Position / Camera =====
local function getPos()
	local char = LocalPlayer.Character
	if not char then return nil end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return nil end
	return hrp.Position
end
local function getCam()
	local cam = workspace.CurrentCamera
	if not cam then return nil end
	return cam.CFrame
end
local function makeDefaultName(coords)
	local i = 1
	while coords["Pos_" .. i] do i = i + 1 end
	return "Pos_" .. i
end

local function addCoord()
	local pos = getPos()
	if not pos then warn("Character not found.") return false end
	local coords = loadCoords()
	ensureOrders(coords)
	local camCF = getCam()
	local name = makeDefaultName(coords)
	local keys = getSortedKeys(coords)
	coords[name] = {pos={pos.X,pos.Y,pos.Z}, cam=camCF and {camCF:GetComponents()} or nil, tpHotkey=nil, updHotkey=nil, countdownTimer=false, order=#keys+1}
	saveCoords(coords)
	rebuildHotkeys()
	print("[+] Saved:", name)
	return true
end

local function updateCoord(name)
	local coords = loadCoords()
	local data = coords[name]
	if not data then warn("Not found:", name) return false end
	local pos = getPos()
	if not pos then warn("Character not found.") return false end
	local camCF = getCam()
	data.pos = {pos.X, pos.Y, pos.Z}
	data.cam = camCF and {camCF:GetComponents()} or nil
	saveCoords(coords)
	rebuildHotkeys()
	print("[~] Updated:", name)
	return true
end

local function tpCoord(name)
	local coords = loadCoords()
	local data = coords[name]
	if not data then warn("Not found:", name) return false end
	local char = LocalPlayer.Character
	if not char then return false end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return false end
	local posData = data.pos or data
	if not posData then return false end
	hrp.CFrame = CFrame.new(posData[1], posData[2], posData[3])
	if data.cam then
		local cam = workspace.CurrentCamera
		if cam then
			cam.CameraType = Enum.CameraType.Scriptable
			cam.CFrame = CFrame.new(unpackFn(data.cam))
			task.wait(0.25)
			cam.CameraType = Enum.CameraType.Custom
		end
	end
	print("[TP]", name)
	startCountdownIfNeeded(name)
	return true
end

local function delCoord(name)
	local coords = loadCoords()
	if coords[name] then
		coords[name] = nil
		local keys = getSortedKeys(coords)
		applyOrders(coords, keys)
		saveCoords(coords)
		rebuildHotkeys()
		print("[-] Deleted:", name)
		return true
	end
	warn("Name not found:", name)
	return false
end

local function renameCoord(oldName, newName)
	newName = trim(newName)
	if newName == "" then warn("Name cannot be blank.") return false end
	if newName == oldName then return true end
	local coords = loadCoords()
	if coords[newName] then warn("Name exists:", newName) return false end
	if not coords[oldName] then warn("Old coord missing:", oldName) return false end
	coords[newName] = coords[oldName]
	coords[oldName] = nil
	saveCoords(coords)
	rebuildHotkeys()
	return true
end

local function listCoords()
	local coords = loadCoords()
	local keys = getSortedKeys(coords)
	for _, name in ipairs(keys) do
		local data = coords[name]
		local p = data.pos or data
		print(string.format("%s -> (%.2f, %.2f, %.2f)", name, p[1], p[2], p[3]))
	end
	if next(coords) == nil then print("(empty)") end
end

