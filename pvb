-- This is your original method, unchanged: suppressor hides the pack/card
-- popups, then we spam OpenHeldPack. Animations queue silently; rejoin to clear.
-- The ONLY addition is pack-type selection.
local packOpRunning = false
local suppressorActive = false

local PACK_TYPES = {
	{ label = "Shiny Expansion", match = function(n) return n:find("shiny")     and n:find("expansion") end },
	{ label = "Expansion",       match = function(n) return n:find("expansion") and not n:find("shiny") end },
	{ label = "Shiny Base",      match = function(n) return n:find("shiny")     and n:find("base") end },
	{ label = "Base",            match = function(n) return n:find("base")      and not n:find("shiny") end },
}
local selectedPack = 1

local function findPack(matchFn)
	local char = LocalPlayer.Character
	local backpack = LocalPlayer:FindFirstChild("Backpack")
	if backpack then
		for _, t in pairs(backpack:GetChildren()) do
			if t:IsA("Tool") and matchFn(t.Name:lower()) then return t end
		end
	end
	if char then
		local h = char:FindFirstChildOfClass("Tool")
		if h and matchFn(h.Name:lower()) then return h end
	end
end

local function stopSuppressor()
	getgenv().KillPackGui = false
end

local function openCards(setStatus)
	setStatus = setStatus or function() end
	if packOpRunning then setStatus("Already opening packs...") return end
	packOpRunning = true
	local packDef = PACK_TYPES[selectedPack]

	-- suppressor (stays on until you rejoin, or call Coords.stopOpen())
	getgenv().KillPackGui = true
	if not suppressorActive then
		suppressorActive = true
		task.spawn(function()
			local pg = LocalPlayer:WaitForChild("PlayerGui")
			while getgenv().KillPackGui do
				for _, gui in pairs(pg:GetChildren()) do
					local n = gui.Name:lower()
					if gui:IsA("ScreenGui") and (n:find("pack") or n:find("card")) then gui.Enabled = false end
				end
				task.wait(0.05)
			end
			suppressorActive = false
		end)
	end

	-- fire loop (exactly your original)
	task.spawn(function()
		local opened = 0
		for i = 1, 900 do
			local char = LocalPlayer.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local p = findPack(packDef.match)
			if not (p and hum) then break end
			hum:EquipTool(p)
			task.wait(0.05)
			RS.Remotes.OpenHeldPack:FireServer()
			task.wait(0.1)
			opened = opened + 1
			if opened % 10 == 0 then setStatus(("Opening %s... %d"):format(packDef.label, opened)) end
		end
		if opened == 0 then
			setStatus("No '" .. packDef.label .. "' packs found in hotbar/backpack.")
		else
			setStatus(("Fired %d %s. Rejoin to clear the animations."):format(opened, packDef.label))
		end
		print("[OpenCards]", packDef.label, opened)
		packOpRunning = false
	end)
end

