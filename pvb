	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		resizing = false
	end
end)

UIS.InputChanged:Connect(function(input)
	if resizing and input.UserInputType == Enum.UserInputType.MouseMovement then
		local mouse = UIS:GetMouseLocation()
		local delta = mouse - resizeStartMouse

		local newW = math.clamp(resizeStartSize.X + delta.X, 390, 700)
		local newH = math.clamp(resizeStartSize.Y + delta.Y, 140, 700)

		frame.Size = UDim2.new(0, newW, 0, newH)
	end
end)

-- ===== Drag Reorder Logic =====
local draggingName = nil
local ROW_HEIGHT = 34
local ROW_PAD = 4

local function moveCoordToIndex(coordName, targetIndex)
	local coords = loadCoords()
	local keys = getSortedKeys(coords)

	local currentIndex = table.find(keys, coordName)

	if not currentIndex then return end

	targetIndex = math.clamp(targetIndex, 1, #keys)

	if currentIndex == targetIndex then
		return
	end

	table.remove(keys, currentIndex)
	table.insert(keys, targetIndex, coordName)

	applyOrders(coords, keys)
	saveCoords(coords)
end

-- ===== Hotkey Box Recording =====
local activeHotkeyBox = nil

local function connectHotkeyBox(box, name, field, oldValue)
	box.Focused:Connect(function()
		activeHotkeyBox = box
		box.PlaceholderText = "press"
	end)

	box.FocusLost:Connect(function()
		if activeHotkeyBox == box then
			activeHotkeyBox = nil
		end

		local ok = setCoordHotkey(name, field, box.Text)

		if ok then
			if refreshList then
				task.defer(refreshList)
			end
		else
			box.Text = oldValue or ""
		end
	end)
end

UIS.InputBegan:Connect(function(input)
	if input.UserInputType ~= Enum.UserInputType.Keyboard then
		return
	end

	local focusedBox = UIS:GetFocusedTextBox()

	if activeHotkeyBox and focusedBox == activeHotkeyBox then
		if input.KeyCode == Enum.KeyCode.Backspace or input.KeyCode == Enum.KeyCode.Delete then
			activeHotkeyBox.Text = ""
			activeHotkeyBox:ReleaseFocus()
			return
		end

		if input.KeyCode == Enum.KeyCode.Escape then
			activeHotkeyBox:ReleaseFocus()
			return
		end

		local combo = comboFromKeyCode(input.KeyCode)

		if combo then
			activeHotkeyBox.Text = combo
			activeHotkeyBox:ReleaseFocus()
		end

		return
	end

	if focusedBox then
		return
	end

	local combo = comboFromKeyCode(input.KeyCode)

	if not combo then
		return
	end

	local updName = updHotkeyMap[combo]

	if updName then
		if updateCoord(updName) and refreshList then
			refreshList()
		end

		return
	end

	local tpName = tpHotkeyMap[combo]

	if tpName then
		tpCoord(tpName)
	end
end)

