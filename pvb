----------------------------------------------------------------------
--  TELEPORT TAB
----------------------------------------------------------------------
do
    local FOLDER, FILE, BACKUP = ".Cordinat", ".Cordinat/kito.json", ".Cordinat/kito_backup.json"
    local canWrite = (type(writefile)=="function" and type(readfile)=="function")
    local canFS = (type(isfile)=="function" and type(isfolder)=="function" and type(makefolder)=="function")
    if canFS and not isfolder(FOLDER) then pcall(makefolder, FOLDER) end

    local coordsCache, tpHotkeyMap, updHotkeyMap = {}, {}, {}
    local refreshList
    local COUNTDOWN_SECONDS = 90
    local countdownEndsAt = 0
    local function trim(s) return tostring(s or ""):match("^%s*(.-)%s*$") end

    local function fmt(sec) sec=math.max(0,math.ceil(sec)); return string.format("%d:%02d", math.floor(sec/60), sec%60) end
    local function updateCountdown()
        if countdownEndsAt<=0 then countdownLabel.Text="T --" return end
        local r=countdownEndsAt-os.clock()
        if r<=0 then countdownEndsAt=0; countdownLabel.Text="T 0:00" else countdownLabel.Text="T "..fmt(r) end
    end

    local function instant(o) if o:IsA("ProximityPrompt") then o.HoldDuration=0 end end
    for _,o in ipairs(game:GetDescendants()) do instant(o) end
    game.DescendantAdded:Connect(instant)

    local num2disp={Zero="0",One="1",Two="2",Three="3",Four="4",Five="5",Six="6",Seven="7",Eight="8",Nine="9"}
    local disp2key={["0"]="Zero",["1"]="One",["2"]="Two",["3"]="Three",["4"]="Four",["5"]="Five",["6"]="Six",["7"]="Seven",["8"]="Eight",["9"]="Nine"}
    local modKeys={LeftControl=true,RightControl=true,LeftShift=true,RightShift=true,LeftAlt=true,RightAlt=true}
    local keyByLower, dispByLower = {}, {}
    local function dispFrom(n) return num2disp[n] or n end
    for _,it in ipairs(Enum.KeyCode:GetEnumItems()) do
        keyByLower[it.Name:lower()]=it.Name; dispByLower[dispFrom(it.Name):lower()]=it.Name
    end
    local alias={esc="Escape",escape="Escape",enter="Return",space="Space",del="Delete",delete="Delete",tab="Tab"}
    local function normMain(p) p=trim(p); if p=="" then return nil end local l=p:lower()
        if disp2key[p] then return dispFrom(disp2key[p]) end
        if alias[l] then return dispFrom(alias[l]) end
        if keyByLower[l] then return dispFrom(keyByLower[l]) end
        if dispByLower[l] then return dispFrom(dispByLower[l]) end
        return false end
    local function normCombo(text) text=trim(text); if text=="" then return nil end text=text:gsub("%s+","")
        local parts={}; for p in text:gmatch("[^+]+") do table.insert(parts,p) end
        local ctrl,alt,shift,main=false,false,false,nil
        for _,p in ipairs(parts) do local l=p:lower()
            if l=="ctrl" or l=="control" then ctrl=true elseif l=="alt" then alt=true elseif l=="shift" then shift=true
            else local k=normMain(p); if k==false then return false end if main then return false end main=k end end
        if not main then return false end
        local c={} if ctrl then table.insert(c,"Ctrl") end if alt then table.insert(c,"Alt") end if shift then table.insert(c,"Shift") end
        table.insert(c,main); return table.concat(c,"+") end
    local function isDown(k) return UIS:IsKeyDown(Enum.KeyCode[k]) end
    local function comboFromKC(kc) local n=kc.Name if n=="Unknown" or modKeys[n] then return nil end
        local c={} if isDown("LeftControl") or isDown("RightControl") then table.insert(c,"Ctrl") end
        if isDown("LeftAlt") or isDown("RightAlt") then table.insert(c,"Alt") end
        if isDown("LeftShift") or isDown("RightShift") then table.insert(c,"Shift") end
        table.insert(c,dispFrom(n)); return table.concat(c,"+") end

    local function readJson(path)
        if not canWrite then return nil end
        if canFS and not isfile(path) then return nil end
        local ok2,d = pcall(readfile,path); if not ok2 or not d or #d==0 then return nil end
        local ok3,t = pcall(function() return HttpService:JSONDecode(d) end)
        return (ok3 and type(t)=="table") and t or nil
    end
    local function loadCoords() local t=readJson(FILE) or readJson(BACKUP); if t then coordsCache=t end return coordsCache end
    local function saveCoords(t) coordsCache=t
        if not canWrite then return false end
        if canFS and not isfolder(FOLDER) then pcall(makefolder,FOLDER) end
        local ok2,j=pcall(function() return HttpService:JSONEncode(t) end); if not ok2 then return false end
        local a=pcall(writefile,FILE,j); local b=pcall(writefile,BACKUP,j); return a or b end

    local function sortedKeys(c) local k={} for n in pairs(c) do table.insert(k,n) end
        table.sort(k,function(a,b) local oa,ob=c[a] and c[a].order, c[b] and c[b].order
            if type(oa)=="number" and type(ob)=="number" and oa~=ob then return oa<ob end
            if type(oa)=="number" and type(ob)~="number" then return true end
            if type(oa)~="number" and type(ob)=="number" then return false end
            return a:lower()<b:lower() end) return k end
    local function applyOrders(c,k) for i,n in ipairs(k) do if c[n] then c[n].order=i end end end

    local function getPos() local ch=LocalPlayer.Character; local h=ch and ch:FindFirstChild("HumanoidRootPart"); return h and h.Position end
    local function getCam() local cam=workspace.CurrentCamera; return cam and cam.CFrame end
    local function defName(c) local i=1 while c["Pos_"..i] do i=i+1 end return "Pos_"..i end

    local function rebuildHotkeys() tpHotkeyMap,updHotkeyMap={},{} local c=loadCoords()
        for n,d in pairs(c) do if type(d)=="table" then
            if d.tpHotkey and d.tpHotkey~="" then tpHotkeyMap[d.tpHotkey]=n end
            if d.updHotkey and d.updHotkey~="" then updHotkeyMap[d.updHotkey]=n end end end end
    local function setHotkey(name,field,text) local c=loadCoords() local d=c[name] if not d then return false end
        local combo=normCombo(text) if combo==false then return false end
        for _,o in pairs(c) do if type(o)=="table" then if o.tpHotkey==combo then o.tpHotkey=nil end if o.updHotkey==combo then o.updHotkey=nil end end end
        d[field]=combo saveCoords(c) rebuildHotkeys() return true end

    local function addCoord() local p=getPos() if not p then setStatus("No character.") return false end
        local c=loadCoords() local cam=getCam() local n=defName(c) local k=sortedKeys(c)
        c[n]={pos={p.X,p.Y,p.Z},cam=cam and {cam:GetComponents()} or nil,countdownTimer=false,order=#k+1}
        saveCoords(c) rebuildHotkeys() return true end
    local function updateCoord(name) local c=loadCoords() local d=c[name] if not d then return false end
        local p=getPos() if not p then return false end local cam=getCam()
        d.pos={p.X,p.Y,p.Z} d.cam=cam and {cam:GetComponents()} or nil saveCoords(c) rebuildHotkeys() return true end
    local function tpCoord(name) local c=loadCoords() local d=c[name] if not d then return false end
        local ch=LocalPlayer.Character local h=ch and ch:FindFirstChild("HumanoidRootPart") if not h then return false end
        local pd=d.pos or d h.CFrame=CFrame.new(pd[1],pd[2],pd[3])
        if d.cam then local cam=workspace.CurrentCamera if cam then cam.CameraType=Enum.CameraType.Scriptable
            cam.CFrame=CFrame.new(unpackFn(d.cam)) task.wait(0.25) cam.CameraType=Enum.CameraType.Custom end end
        if d.countdownTimer then countdownEndsAt=os.clock()+COUNTDOWN_SECONDS updateCountdown() end
        return true end
    local function delCoord(name) local c=loadCoords() if c[name] then c[name]=nil applyOrders(c,sortedKeys(c)) saveCoords(c) rebuildHotkeys() return true end return false end
    local function renameCoord(o,n) n=trim(n) if n=="" then return false end if n==o then return true end
        local c=loadCoords() if c[n] or not c[o] then return false end c[n]=c[o] c[o]=nil saveCoords(c) rebuildHotkeys() return true end
    local function toggleTimer(name) local c=loadCoords() local d=c[name] if not d then return false end
        local was=d.countdownTimer==true for _,o in pairs(c) do if type(o)=="table" then o.countdownTimer=false end end
        d.countdownTimer = not was saveCoords(c) return true end

    local saveBtn  = mkButton(tpTab,"+ Save Pos",C.green,UDim2.fromOffset(96,26),UDim2.fromOffset(0,0))
    local refBtn   = mkButton(tpTab,"Refresh",C.blue,UDim2.fromOffset(84,26),UDim2.fromOffset(102,0))
    local antiBtn  = mkButton(tpTab,"AntiAFK: OFF",C.grey,UDim2.fromOffset(110,26),UDim2.fromOffset(192,0))
    do
        local VU = nil pcall(function() VU = game:GetService("VirtualUser") end)
        LocalPlayer.Idled:Connect(function()
            if getgenv().PvBAntiAFK and VU then
                pcall(function() VU:CaptureController() VU:ClickButton2(Vector2.new()) end)
            end
        end)
        antiBtn.MouseButton1Click:Connect(function()
            getgenv().PvBAntiAFK = not getgenv().PvBAntiAFK
            local on = getgenv().PvBAntiAFK
            antiBtn.Text = "AntiAFK: "..(on and "ON" or "OFF")
            antiBtn.BackgroundColor3 = on and C.green or C.grey
            setStatus("Anti-AFK "..(on and "on (idle kick disabled)" or "off"))
        end)
    end
    local listFrame=Instance.new("ScrollingFrame",tpTab)
    listFrame.Size=UDim2.new(1,0,1,-34); listFrame.Position=UDim2.fromOffset(0,32)
    listFrame.BackgroundColor3=C.panel; listFrame.BackgroundTransparency=0.15; listFrame.BorderSizePixel=0
    listFrame.ScrollBarThickness=6; listFrame.CanvasSize=UDim2.new(); listFrame.AutomaticCanvasSize=Enum.AutomaticSize.Y
    corner(listFrame,8)
    local ll=Instance.new("UIListLayout",listFrame); ll.SortOrder=Enum.SortOrder.LayoutOrder; ll.Padding=UDim.new(0,4)
    local lp=Instance.new("UIPadding",listFrame); lp.PaddingTop=UDim.new(0,4); lp.PaddingLeft=UDim.new(0,4); lp.PaddingRight=UDim.new(0,4)

    local ROW_H=34
    local draggingName=nil
    local function moveTo(name,idx) local c=loadCoords() local k=sortedKeys(c) local cur=table.find(k,name) if not cur then return end
        idx=math.clamp(idx,1,#k) if cur==idx then return end table.remove(k,cur) table.insert(k,idx,name) applyOrders(c,k) saveCoords(c) end

    local activeBox=nil
    local function bindBox(box,name,field,old)
        box.Focused:Connect(function() activeBox=box box.PlaceholderText="press" end)
        box.FocusLost:Connect(function() if activeBox==box then activeBox=nil end
            if setHotkey(name,field,box.Text) then if refreshList then task.defer(refreshList) end else box.Text=old or "" end end)
    end

    refreshList=function()
        local c=loadCoords()
        for _,v in pairs(listFrame:GetChildren()) do if v:IsA("Frame") then v:Destroy() end end
        for i,name in ipairs(sortedKeys(c)) do local d=c[name]
            local item=Instance.new("Frame",listFrame); item.Size=UDim2.new(1,-8,0,ROW_H); item.BackgroundColor3=C.row
            item.BackgroundTransparency=0.05; item.BorderSizePixel=0; item.LayoutOrder=d.order or i; corner(item,7)
            local function el(w,x) return UDim2.new(0,w,1,-6), UDim2.fromOffset(x,3) end
            local drag=mkButton(item,"=",Color3.fromRGB(60,60,70),el(22,3)); drag.AutoButtonColor=false
            local nameBox=Instance.new("TextBox",item); nameBox.Size,nameBox.Position=el(90,28)
            nameBox.Text=name; nameBox.ClearTextOnFocus=false; nameBox.BackgroundColor3=C.field; nameBox.TextColor3=Color3.new(1,1,1)
            nameBox.BorderSizePixel=0; nameBox.Font=Enum.Font.Gotham; nameBox.TextSize=12; corner(nameBox,5)
            local tpKey=Instance.new("TextBox",item); tpKey.Size,tpKey.Position=el(50,122)
            tpKey.PlaceholderText="TP"; tpKey.Text=d.tpHotkey or ""; tpKey.ClearTextOnFocus=false; tpKey.BackgroundColor3=C.field
            tpKey.TextColor3=Color3.new(1,1,1); tpKey.BorderSizePixel=0; tpKey.Font=Enum.Font.Gotham; tpKey.TextSize=11; corner(tpKey,5)
            local updKey=Instance.new("TextBox",item); updKey.Size,updKey.Position=el(50,174)
            updKey.PlaceholderText="UPD"; updKey.Text=d.updHotkey or ""; updKey.ClearTextOnFocus=false; updKey.BackgroundColor3=C.field
            updKey.TextColor3=Color3.new(1,1,1); updKey.BorderSizePixel=0; updKey.Font=Enum.Font.Gotham; updKey.TextSize=11; corner(updKey,5)
            local tBtn=mkButton(item,d.countdownTimer and "T" or "o",d.countdownTimer and C.amber or Color3.fromRGB(64,64,74),el(24,226))
            local tpBtn=mkButton(item,"TP",C.grey,el(30,253))
            local upBtn=mkButton(item,"UPD",Color3.fromRGB(180,120,45),el(38,285))
            local dBtn=mkButton(item,"DEL",C.red,el(34,325))
            drag.InputBegan:Connect(function(io) if io.UserInputType==Enum.UserInputType.MouseButton1 then draggingName=name end end)
            nameBox.FocusLost:Connect(function() local nn=trim(nameBox.Text) if nn~=name then if renameCoord(name,nn) then refreshList() else nameBox.Text=name end end end)
            bindBox(tpKey,name,"tpHotkey",d.tpHotkey); bindBox(updKey,name,"updHotkey",d.updHotkey)
            tBtn.MouseButton1Click:Connect(function() if toggleTimer(name) then refreshList() end end)
            tpBtn.MouseButton1Click:Connect(function() tpCoord(name) end)
            upBtn.MouseButton1Click:Connect(function() if updateCoord(name) then refreshList() end end)
            dBtn.MouseButton1Click:Connect(function() if delCoord(name) then refreshList() end end)
        end
    end

    saveBtn.MouseButton1Click:Connect(function() if addCoord() then refreshList() setStatus("Saved position.") end end)
    refBtn.MouseButton1Click:Connect(function() rebuildHotkeys() refreshList() setStatus("Refreshed.") end)

    UIS.InputBegan:Connect(function(input)
        if input.UserInputType~=Enum.UserInputType.Keyboard then return end
        local fb=UIS:GetFocusedTextBox()
        if activeBox and fb==activeBox then
            if input.KeyCode==Enum.KeyCode.Backspace or input.KeyCode==Enum.KeyCode.Delete then activeBox.Text="" activeBox:ReleaseFocus() return end
            if input.KeyCode==Enum.KeyCode.Escape then activeBox:ReleaseFocus() return end
            local c=comboFromKC(input.KeyCode) if c then activeBox.Text=c activeBox:ReleaseFocus() end return end
        if fb then return end
        local c=comboFromKC(input.KeyCode) if not c then return end
        local u=updHotkeyMap[c] if u then if updateCoord(u) then refreshList() end return end
        local t=tpHotkeyMap[c] if t then tpCoord(t) end
    end)
    UIS.InputChanged:Connect(function(input) if draggingName and input.UserInputType==Enum.UserInputType.MouseMovement then
        local y=UIS:GetMouseLocation().Y - listFrame.AbsolutePosition.Y + listFrame.CanvasPosition.Y
        moveTo(draggingName, math.floor(y/(ROW_H+4))+1) refreshList() end end)
    UIS.InputEnded:Connect(function(input) if input.UserInputType==Enum.UserInputType.MouseButton1 then draggingName=nil end end)

    task.spawn(function() while gui.Parent do updateCountdown() task.wait(0.2) end end)
    loadCoords(); rebuildHotkeys(); refreshList()
end

----------------------------------------------------------------------
--  CARDS TAB
----------------------------------------------------------------------
do
    local packOpRunning, suppressorActive = false, false
    local PACK_TYPES = {
        { label="Shiny Expansion", match=function(n) return n:find("shiny") and n:find("expansion") end },
        { label="Expansion",       match=function(n) return n:find("expansion") and not n:find("shiny") end },
        { label="Shiny Base",      match=function(n) return n:find("shiny") and n:find("base") end },
        { label="Base",            match=function(n) return n:find("base") and not n:find("shiny") end },
    }
    local selectedPack = 1
    local function findPack(m) local bp=LocalPlayer:FindFirstChild("Backpack")
        if bp then for _,t in ipairs(bp:GetChildren()) do if t:IsA("Tool") and m(t.Name:lower()) then return t end end end
        local ch=LocalPlayer.Character local h=ch and ch:FindFirstChildOfClass("Tool") if h and m(h.Name:lower()) then return h end end

    local function openCards()
        if packOpRunning then setStatus("Already opening...") return end
        packOpRunning=true local def=PACK_TYPES[selectedPack]
        getgenv().KillPackGui=true
        if not suppressorActive then suppressorActive=true task.spawn(function()
            local pg=LocalPlayer:WaitForChild("PlayerGui")
            while getgenv().KillPackGui do for _,g in pairs(pg:GetChildren()) do local n=g.Name:lower()
                if g:IsA("ScreenGui") and (n:find("pack") or n:find("card")) then g.Enabled=false end end task.wait(0.05) end
            suppressorActive=false end) end
        task.spawn(function() local opened=0
            for i=1,900 do local ch=LocalPlayer.Character local hum=ch and ch:FindFirstChildOfClass("Humanoid")
                local p=findPack(def.match) if not (p and hum) then break end
                hum:EquipTool(p) task.wait(0.05) RS.Remotes.OpenHeldPack:FireServer() task.wait(0.1) opened+=1
                if opened%10==0 then setStatus(("Opening %s... %d"):format(def.label,opened)) end end
            setStatus(opened==0 and ("No '"..def.label.."' packs found.") or (("Fired %d %s. Rejoin to clear animations."):format(opened,def.label)))
            packOpRunning=false end)
    end

    local function deleteCards()
        task.spawn(function() local ok2,err=pcall(function()
            local pg=LocalPlayer:WaitForChild("PlayerGui")
            local sz=pg:FindFirstChild("SiblingZIndex") local deck=sz and sz:FindFirstChild("DeckCreator")
            local mc=deck and deck:FindFirstChild("Main") mc=mc and mc:FindFirstChild("Main_Content")
            if not mc then setStatus("Open the card menu first.") return end
            local Cards=mc:FindFirstChild("Cards") local DeleteCards=RS.Remotes.Cards.General.DeleteCards
            if not Cards then setStatus("Card grid not found.") return end
            local function tierOf(t) t=(t or ""):upper() if t:find("III") then return 3 elseif t:find("II") then return 2 else return 1 end end
            local function readFrame(c) local m=c:FindFirstChild("Main") if not m then return nil end
                local nl=m:FindFirstChild("Name") local r=m:FindFirstChild("Rarity")
                local a=nl and nl.Parent:FindFirstChild("Amount") local cnt=1
                if a and a.Text then local n=tonumber((a.Text:gsub("[^%d]",""))) if n and n>0 then cnt=n end end
                return {name=nl and nl.Text or "?",tier=tierOf(r and r.Text),shiny=m:FindFirstChild("Hidden_Details")~=nil,count=cnt} end
            local function vkey(n,s) return (n:lower():gsub("^%s+",""):gsub("%s+$","")).."|"..(s and "S" or "N") end
            local pageBox for _,o in ipairs(mc:GetDescendants()) do if o:IsA("TextBox") and (o.Text or ""):match("%d+%s*/%s*%d+") then pageBox=o break end end
            if not pageBox then setStatus("Page box not found.") return end
            local function cur() return tonumber((pageBox.Text or ""):match("(%d+)")) end
            local function maxp() return tonumber((pageBox.Text or ""):match("/%s*(%d+)")) end
            local function goto(n) for _=1,3 do pcall(function() pageBox:CaptureFocus() task.wait(0.08) pageBox.Text=tostring(n)
                task.wait(0.05) VIM:SendKeyEvent(true,Enum.KeyCode.Return,false,game) task.wait(0.04) VIM:SendKeyEvent(false,Enum.KeyCode.Return,false,game)
                pcall(function() pageBox:ReleaseFocus(true) end) end) task.wait(0.5) if cur()==n then return true end end return false end
            local mx=maxp() if not mx then setStatus("Couldn't read page count.") return end
            if not goto(1) then setStatus("Couldn't go to page 1.") return end
            local store={} for n=1,mx do if cur()~=n then goto(n) end task.wait(0.15)
                for _,c in ipairs(Cards:GetChildren()) do if c:IsA("Frame") and c.Name~="NormalTemplate" and c.Name~="ShinyTemplate" then
                    if not store[c.Name] then local i=readFrame(c) if i then i.uuid=c.Name store[c.Name]=i end end end end
                setStatus(("Reading page %d/%d"):format(n,mx)) end
            local hasT3={} for _,i in pairs(store) do if i.tier==3 and i.count>=1 then hasT3[vkey(i.name,i.shiny)]=true end end
            local plan,total={},0 for _,i in pairs(store) do local target
                if i.tier==3 then target=1 else target=hasT3[vkey(i.name,i.shiny)] and 0 or i.count end
                local f=i.count-target if f>0 then total=total+f table.insert(plan,{uuid=i.uuid,fires=f}) end end
            if total==0 then setStatus("Nothing to delete - already clean.") return end
            local queue={} for _,p in ipairs(plan) do for _=1,p.fires do queue[#queue+1]=p.uuid end end
            local BATCH,done=25,0
            for i=1,#queue,BATCH do local chunk={} for j=i,math.min(i+BATCH-1,#queue) do chunk[#chunk+1]=queue[j] end
                DeleteCards:FireServer(chunk) done=done+#chunk setStatus(("Deleting %d/%d"):format(done,total)) task.wait(0.12) end
            setStatus(("Done - deleted %d cards."):format(total))
        end) if not ok2 then setStatus("Delete error: "..tostring(err)) end end)
    end

    local packBtn = mkButton(cardTab,"v "..PACK_TYPES[selectedPack].label,C.panel,UDim2.fromOffset(150,28),UDim2.fromOffset(0,0))
    packBtn.TextXAlignment=Enum.TextXAlignment.Left local pp=Instance.new("UIPadding",packBtn) pp.PaddingLeft=UDim.new(0,8)
    local openBtn=mkButton(cardTab,"Open Cards",C.purple,UDim2.fromOffset(108,28),UDim2.fromOffset(158,0))
    local delBtn=mkButton(cardTab,"Delete Cards",C.amber,UDim2.fromOffset(120,28),UDim2.fromOffset(272,0))
    local stopBtn=mkButton(cardTab,"Stop suppressor (re-enable popups)",C.grey,UDim2.fromOffset(392,26),UDim2.fromOffset(0,36))
    mkLabel(cardTab,"Pick a pack, Open Cards, then rejoin to clear animations. Open the card menu before Delete.",
        UDim2.new(1,0,0,40),UDim2.fromOffset(0,70),C.dim,Enum.Font.Gotham,11).TextWrapped=true

    local drop=Instance.new("Frame",cardTab) drop.Visible=false drop.Size=UDim2.fromOffset(150,(#PACK_TYPES*28)+8)
    drop.Position=UDim2.fromOffset(0,30) drop.BackgroundColor3=C.panel drop.BorderSizePixel=0 drop.ZIndex=50 corner(drop,6)
    local dl=Instance.new("UIListLayout",drop) dl.Padding=UDim.new(0,2) local dpad=Instance.new("UIPadding",drop)
    dpad.PaddingTop=UDim.new(0,3) dpad.PaddingLeft=UDim.new(0,3) dpad.PaddingRight=UDim.new(0,3)
    for idx,pt in ipairs(PACK_TYPES) do local opt=mkButton(drop,pt.label,C.row,UDim2.new(1,0,0,26),UDim2.new()) opt.ZIndex=51 opt.LayoutOrder=idx
        opt.MouseButton1Click:Connect(function() selectedPack=idx packBtn.Text="v "..pt.label drop.Visible=false setStatus("Pack: "..pt.label) end) end
    packBtn.MouseButton1Click:Connect(function() drop.Visible=not drop.Visible end)
    openBtn.MouseButton1Click:Connect(function() setStatus("Opening...") openCards() end)
    delBtn.MouseButton1Click:Connect(function() setStatus("Deleting...") deleteCards() end)
    stopBtn.MouseButton1Click:Connect(function() getgenv().KillPackGui=false setStatus("Suppressor stopped.") end)
end

----------------------------------------------------------------------
--  KEEP TAB  (filter flips at the kill line)
----------------------------------------------------------------------
do
    local AutoSell = RS.Remotes.AutoSell
    local FavoriteItem = RS.Remotes.FavoriteItem
    local LANE = workspace:WaitForChild("ScriptedMap"):WaitForChild("MissionBrainrots")
    local BP = LocalPlayer:WaitForChild("Backpack")

    local KEEP_Z = 595

    -- DEFAULTS: keep on, forbidden on, 1M-only mode on, secrets >=75kg always
    -- kept, anything >=150kg kept, junk-sell on.
    local cfg    = { enabled=true, keepForbidden=true, keepSecretKg=75, keepAnyKg=150, doHeart=true, invManage=true, keepOneMil=true }
    local staged = { enabled=true, keepForbidden=true, keepSecretKg=75, keepAnyKg=150, doHeart=true, invManage=true, keepOneMil=true }
    local function kgToSize(kg) return kg/10 end
    local secretNames = {}

    local function meetsCriteria(rarity,size)
        if cfg.keepForbidden and rarity=="Forbidden" then return true end
        if size and size>kgToSize(cfg.keepAnyKg) then return true end
        return false
    end
    local function shouldKeep(rarity,size)
        return cfg.enabled and meetsCriteria(rarity,size)
    end

    local filterOn, touched = {}, {}
    local function setFilter(rarity,want)
        if (filterOn[rarity] or false)~=want then AutoSell:FireServer(rarity) filterOn[rarity]=want end
    end

    local pending={}
    local function tryHeart(item)
        if item:GetAttribute("PlantName") then return end
        local id=item:GetAttribute("ID") local name=item:GetAttribute("Brainrot") or item:GetAttribute("ItemName") local size=item:GetAttribute("Size")
        if not (id and name and size) then return end
        for i,p in ipairs(pending) do if p.name==name and math.abs(p.size-size)<0.0001 then
            FavoriteItem:FireServer(id) table.remove(pending,i) setStatus("hearted "..name) return end end
    end
    local PD2 pcall(function() PD2 = require(RS:WaitForChild("PlayerData")) end)
    local function isFav(id)
        if PD2 then local ok2,fav=pcall(function() return PD2:GetData().Data.Favorites end)
            if ok2 and type(fav)=="table" then local f=fav[id] return f~=nil and f~=false end end
        return false
    end
    local function setFav(id,want) if isFav(id)~=want then FavoriteItem:FireServer(id) end end
    local function mutOf(item)
        local ms=item:GetAttribute("MutationString")
        local base=item:GetAttribute("Brainrot") or item:GetAttribute("ItemName")
        if ms and base and ms~=base then return ms end
        return "Normal"
    end
    local function secretKeeps(item)
        local size=tonumber(item:GetAttribute("Size")) or 0
        if size > kgToSize(cfg.keepSecretKg) then return true end
        if not cfg.keepOneMil then return true end
        return (tonumber(item:GetAttribute("Worth")) or 0) >= 1000000
    end
    local decided = {}
    local function secretHandler(item)
        local id=item:GetAttribute("ID") if not id then return end
        if decided[id] then return end
        decided[id]=true
        task.wait(0.25)
        local keep=secretKeeps(item)
        setFav(id,keep)
        local w=tonumber(item:GetAttribute("Worth")) or 0
        setStatus((keep and "kept Secret (%s worth=%d)" or "selling Secret (%s worth=%d)"):format(mutOf(item),w))
    end
    local function resweepSecrets()
        for _,t in ipairs(BP:GetChildren()) do
            if t:IsA("Tool") and t:GetAttribute("ID") and not t:GetAttribute("PlantName")
               and t:GetAttribute("Rarity")=="Secret" then
                local id=t:GetAttribute("ID")
                decided[id]=true
                setFav(id, secretKeeps(t))
                task.wait(0.05)
            end
        end
        setStatus("re-swept secrets in bag")
    end
    local lastArrival = 0
    BP.ChildAdded:Connect(function(item)
        if item:IsA("Tool") and item:GetAttribute("ID") and not item:GetAttribute("PlantName") then
            lastArrival=os.clock()
            local nm=item:GetAttribute("Brainrot") or item:GetAttribute("ItemName")
            if nm and secretNames[nm] then task.delay(0.25,function() secretHandler(item) end) return end
        end
        task.delay(0.3,function() tryHeart(item) end)
    end)

    local ItemSell = RS.Remotes:WaitForChild("ItemSell")
    local function hasLooseBrainrot()
        for _,t in ipairs(BP:GetChildren()) do
            if t:IsA("Tool") and t:GetAttribute("ID") and not t:GetAttribute("PlantName") then return true end
        end
        return false
    end
    task.spawn(function()
        while true do
            task.wait(15)
            if cfg.invManage and hasLooseBrainrot() and (os.clock()-lastArrival)>3 then
                ItemSell:FireServer()
                setStatus("auto-sold loose brainrots")
            end
        end
    end)

    local function modelZ(model)
        local ok2,pos = pcall(function() return model:GetPivot().Position end)
        if ok2 and pos then return pos.Z end
        local part = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
        return part and part.Position.Z
    end

    local keepers = {}
    local function watch(model)
        if not model:IsA("Model") then return end
        local size=model:GetAttribute("Size") local t0=os.clock()
        while size==nil and os.clock()-t0<3 do task.wait() size=model:GetAttribute("Size") end
        local rarity=model:GetAttribute("Rarity") local name=model:GetAttribute("Brainrot")
        if not (rarity and size and name) then return end
        if rarity=="Secret" then
            secretNames[name]=true
            keepers[model]="Secret" touched["Secret"]=true
            setStatus("collecting Secret "..name)
            return
        end
        if not shouldKeep(rarity,size) then return end
        setStatus(("keeping %s %dkg"):format(rarity, math.floor(size*10)))
        table.insert(pending,{name=name,size=size,t=os.clock()})
        keepers[model]=rarity
        touched[rarity]=true
    end
    for _,m in ipairs(LANE:GetChildren()) do task.spawn(watch,m) end
    LANE.ChildAdded:Connect(function(m) task.spawn(watch,m) end)

    RunService.Heartbeat:Connect(function()
        local want={}
        for model,rarity in pairs(keepers) do
            if not model.Parent then
                keepers[model]=nil
            else
                local z=modelZ(model)
                if z and z>=KEEP_Z then want[rarity]=true end
            end
        end
        for rarity in pairs(touched) do
            setFilter(rarity, want[rarity]==true)
        end
    end)
    task.spawn(function() while true do task.wait(10) local now=os.clock()
        for i=#pending,1,-1 do if now-pending[i].t>30 then table.remove(pending,i) end end end end)

    local y=0
    local function row(h) local r=Instance.new("Frame",keepTab) r.BackgroundTransparency=1 r.Size=UDim2.new(1,0,0,h) r.Position=UDim2.fromOffset(0,y) y=y+h+6 return r end
    local applyHint
    local function markDirty()
        local dirty=false for k,v in pairs(staged) do if cfg[k]~=v then dirty=true break end end
        if applyHint then applyHint.Text = dirty and "unsaved changes" or "" end
    end
    local function toggle(text,key)
        local r=row(26) local b=mkButton(r,"",C.row,UDim2.new(1,0,1,0),UDim2.new()) b.AutoButtonColor=true
        mkLabel(b,text,UDim2.new(1,-44,1,0),UDim2.fromOffset(8,0),C.txt,Enum.Font.Gotham,13)
        local pip=mkLabel(b,"",UDim2.fromOffset(34,18),UDim2.new(1,-40,0.5,-9),Color3.new(1,1,1),Enum.Font.GothamBold,11)
        pip.TextXAlignment=Enum.TextXAlignment.Center corner(pip,5)
        local function rf() pip.Text=cfg[key] and "ON" or "OFF" pip.BackgroundColor3=cfg[key] and C.green or C.grey end
        b.MouseButton1Click:Connect(function() cfg[key]=not cfg[key] staged[key]=cfg[key] rf() markDirty() end) rf()
    end
    local function input(text,key)
        local r=row(26) mkLabel(r,text,UDim2.new(1,-70,1,0),UDim2.new(),C.txt,Enum.Font.Gotham,13)
        local box=Instance.new("TextBox",r) box.Size=UDim2.fromOffset(62,24) box.Position=UDim2.new(1,-62,0.5,-12)
        box.BackgroundColor3=C.field box.TextColor3=Color3.new(1,1,1) box.Font=Enum.Font.GothamMedium box.TextSize=13
        box.Text=tostring(staged[key]) box.ClearTextOnFocus=false corner(box,6)
        box.FocusLost:Connect(function() local n=tonumber(box.Text) if n then staged[key]=n else box.Text=tostring(staged[key]) end markDirty() end)
    end

    mkLabel(keepTab,"Auto-Keep",UDim2.new(1,0,0,18),UDim2.new(),C.txt,Enum.Font.GothamBold,14) y=22
    toggle("Enabled","enabled")
    toggle("Keep all Forbidden","keepForbidden")
    toggle("Secret mode: 1M only (off = keep all)","keepOneMil")
    input("Keep secrets over (kg)","keepSecretKg")
    input("Keep anything over (kg)","keepAnyKg")
    toggle("Auto-sell junk in bag","invManage")
    local arow=row(30)
    local applyBtn=mkButton(arow,"Apply",C.green,UDim2.fromOffset(90,28),UDim2.new())
    applyHint=mkLabel(arow,"",UDim2.new(1,-100,1,0),UDim2.fromOffset(100,0),C.amber,Enum.Font.Gotham,12)
    applyBtn.MouseButton1Click:Connect(function()
        for k,v in pairs(staged) do cfg[k]=v end
        markDirty() resweepSecrets()
    end)
    mkLabel(keepTab,"Every secret is collected, then kept or sold in the bag by the rule above. Forbidden + anything over the kg line are kept on the lane.",
        UDim2.new(1,0,0,40),UDim2.fromOffset(0,y),C.dim,Enum.Font.Gotham,11).TextWrapped=true
end

----------------------------------------------------------------------
--  PLANT TAB  (garden grid, per-tile grow timers, after-grown actions)
----------------------------------------------------------------------
do
    local CollectionService = game:GetService("CollectionService")
    local PlantSeed    = RS.Remotes:WaitForChild("Seeds"):WaitForChild("PlantSeed")
    local Pickup       = RS.Remotes:WaitForChild("Plants"):WaitForChild("Pickup")
    local FavoriteItem = RS.Remotes:WaitForChild("FavoriteItem")
    local ItemSell     = RS.Remotes:WaitForChild("ItemSell")
    local BP           = LocalPlayer:WaitForChild("Backpack")

    local PlantRegistry
    pcall(function()
        PlantRegistry = require(RS:WaitForChild("Modules"):WaitForChild("Registries"):WaitForChild("PlantRegistry"))
    end)
    local function growTimeFor(seedName)
        if not (PlantRegistry and seedName) then return nil end
        local e = PlantRegistry[seedName]
        if e and tonumber(e.GrowTime) then return tonumber(e.GrowTime) end
        e = PlantRegistry[(seedName:gsub("%s*Seed$",""))]
        if e and tonumber(e.GrowTime) then return tonumber(e.GrowTime) end
        return nil
    end

    local function getMyPlot()
        local plots = workspace:FindFirstChild("Plots")
        if not plots then return nil end
        for _,p in ipairs(plots:GetChildren()) do
            if p:GetAttribute("Owner") == LocalPlayer.UserId then return p end
        end
    end
    local function tileToPos(tile) return (tile.CFrame * CFrame.new(0, tile.Size.Y/2, 0)).Position end
    local function plantable(tile)
        return tile ~= nil and tile:IsA("BasePart")
            and tile:GetAttribute("CanPlace") == true
            and not tile:GetAttribute("Occupied")
    end
    local function listSeeds()
        local out = {}
        for _,c in ipairs({ LocalPlayer:FindFirstChild("Backpack"), LocalPlayer.Character }) do
            if c then for _,t in ipairs(c:GetChildren()) do
                local sn = t:IsA("Tool") and t:GetAttribute("SeedName")
                if sn then table.insert(out, { label=t.Name, seedName=sn, colors=t:GetAttribute("Colors"), qty=tonumber(t:GetAttribute("Quantity")) or 1 }) end
            end end
        end
        table.sort(out, function(a,b) return a.label:lower() < b.label:lower() end)
        return out
    end
    local function plantOnTile(tile)
        local best,bd
        for _,p in ipairs(CollectionService:GetTagged("Plants")) do
            if p:GetAttribute("Owner")==LocalPlayer.UserId and p:GetAttribute("ID") then
                local pos
                if p:IsA("Model") then local ok2,c=pcall(function() return p:GetPivot().Position end) if ok2 then pos=c end
                elseif p:IsA("BasePart") then pos=p.Position end
                if pos then
                    local dx,dz = pos.X-tile.Position.X, pos.Z-tile.Position.Z
                    local d = math.sqrt(dx*dx+dz*dz)
                    if d<4 and (not bd or d<bd) then best,bd=p,d end
                end
            end
        end
        return best
    end
    local function fmtT(s)
        s=math.max(0,math.ceil(s))
        if s>=60 then return ("%d:%02d"):format(math.floor(s/60),s%60) end
        return s.."s"
    end

    local selectedSeed = nil
    local assign = {}
    local active = {}
    local cells  = {}
    local act    = { pickup=false, sell=false, fav=false }

    local function countAssignedTo(name) local n=0 for _,e in pairs(assign) do if e.seedName==name then n=n+1 end end return n end

    local seedBtn = mkButton(plantTab,"v Pick a seed",C.panel,UDim2.fromOffset(200,26),UDim2.fromOffset(0,0))
    seedBtn.TextXAlignment=Enum.TextXAlignment.Left local spad=Instance.new("UIPadding",seedBtn) spad.PaddingLeft=UDim.new(0,8)
    local refreshBtn = mkButton(plantTab,"Refresh",C.blue,UDim2.fromOffset(82,26),UDim2.fromOffset(206,0))
    local clearBtn   = mkButton(plantTab,"Clear",C.grey,UDim2.fromOffset(70,26),UDim2.fromOffset(292,0))

    local toggRow = Instance.new("Frame",plantTab) toggRow.BackgroundTransparency=1
    toggRow.Size=UDim2.new(1,0,0,24) toggRow.Position=UDim2.fromOffset(0,32)
    local rfP,rfS,rfF
    local function refreshActs() if rfP then rfP() end if rfS then rfS() end if rfF then rfF() end end
    local function miniToggle(text,x,w,getv,setv)
        local b=mkButton(toggRow,text,C.row,UDim2.fromOffset(w,24),UDim2.fromOffset(x,0)) b.TextSize=11
        local function rf()
            local on=getv()
            b.BackgroundColor3 = on and C.green or C.row
        end
        b.MouseButton1Click:Connect(function() setv(not getv()) refreshActs() end)
        return rf
    end
    rfP = miniToggle("Pick up when grown",0,150,function() return act.pickup end,function(v)
        act.pickup=v if not v then act.sell=false act.fav=false end end)
    rfS = miniToggle("then Sell",156,86,function() return act.sell end,function(v)
        if not act.pickup then return end act.sell=v if v then act.fav=false end end)
    rfF = miniToggle("then Favorite",246,108,function() return act.fav end,function(v)
        if not act.pickup then return end act.fav=v if v then act.sell=false end end)
    refreshActs()

    local gridHolder = Instance.new("Frame",plantTab)
    gridHolder.BackgroundColor3=C.panel gridHolder.BackgroundTransparency=0.2 gridHolder.BorderSizePixel=0
    gridHolder.Size=UDim2.new(1,0,1,-96) gridHolder.Position=UDim2.fromOffset(0,62) corner(gridHolder,8)
    local gridInner = Instance.new("Frame",gridHolder) gridInner.BackgroundTransparency=1
    gridInner.AnchorPoint=Vector2.new(0.5,0.5) gridInner.Position=UDim2.new(0.5,0,0.5,0)

    local plantBtn  = mkButton(plantTab,"Plant",C.green,UDim2.fromOffset(120,30),UDim2.new(0,0,1,-32))
    local infoLabel = mkLabel(plantTab,"",UDim2.new(1,-130,0,30),UDim2.new(0,128,1,-30),C.dim,Enum.Font.Gotham,12)

    local function updateInfo()
        local n=0 for _ in pairs(assign) do n=n+1 end
        infoLabel.Text = n.." queued"..(selectedSeed and (" | "..selectedSeed.label.." x"..selectedSeed.qty) or "")
    end
    local function styleCell(tile,btn,free)
        if active[tile] then btn.BackgroundColor3=C.blue
        elseif assign[tile] then btn.BackgroundColor3=C.green
        elseif free then btn.BackgroundColor3=Color3.fromRGB(58,92,58)
        else btn.BackgroundColor3=Color3.fromRGB(104,40,40) end
        btn.Text = assign[tile] and assign[tile].label:sub(1,1):upper() or ""
    end
    local function refreshCellStyles()
        for tile,cell in pairs(cells) do styleCell(tile,cell.btn,plantable(tile)) end
    end

    local rebuildGrid, rebuildSeedDrop
    local function pickupTile(tile, sellAfter, favAfter)
        local p=plantOnTile(tile)
        if not p then setStatus("no plant found on that tile") return false end
        local id=p:GetAttribute("ID")
        Pickup:FireServer(id)
        active[tile]=nil
        local cell=cells[tile] if cell and cell.timer then cell.timer.Text="" end
        refreshCellStyles()
        task.spawn(function()
            local tool,t=nil,0
            while not tool and t<3 do
                task.wait(0.2) t+=0.2
                for _,c in ipairs({ BP, LocalPlayer.Character }) do
                    if c then for _,it in ipairs(c:GetChildren()) do
                        if it:IsA("Tool") and it:GetAttribute("ID")==id then tool=it break end
                    end end
                    if tool then break end
                end
            end
            if favAfter and tool then
                FavoriteItem:FireServer(id) setStatus("picked up + favorited")
            elseif sellAfter and tool then
                local char=LocalPlayer.Character local hum=char and char:FindFirstChildOfClass("Humanoid")
                if hum then
                    local prev=char:FindFirstChildWhichIsA("Tool")
                    hum:EquipTool(tool)
                    local w=0 while tool.Parent~=char and w<1 do task.wait(0.03) w+=0.03 end
                    ItemSell:FireServer(true) task.wait(0.2)
                    if prev and prev.Parent==BP then pcall(function() hum:EquipTool(prev) end) end
                end
                setStatus("picked up + sold")
            else
                setStatus("picked up")
            end
            if rebuildGrid then rebuildGrid() end
        end)
        return true
    end
    local function handleGrown(tile,a)
        if a.pickup then pickupTile(tile, a.sell, a.fav) return end
        a.done=true
        local cell=cells[tile] if cell and cell.timer then cell.timer.Text="done" end
        refreshCellStyles()
    end

    rebuildGrid = function()
        for _,cell in pairs(cells) do if cell.btn then cell.btn:Destroy() end end
        cells={}
        for _,ch in ipairs(gridInner:GetChildren()) do if ch:IsA("UIGridLayout") then ch:Destroy() end end
        local plot=getMyPlot()
        if not plot then gridInner.Size=UDim2.fromOffset(10,10) setStatus("Plant: couldn't find your plot.") return end
        local rowsFolder=plot:FindFirstChild("Rows")
        if not rowsFolder then setStatus("Plant: no Rows under your plot.") return end
        local tiles={}
        for _,r in ipairs(rowsFolder:GetChildren()) do local g=r:FindFirstChild("Grass")
            if g then for _,t in ipairs(g:GetChildren()) do if t:IsA("BasePart") then table.insert(tiles,t) end end end end
        if #tiles==0 then setStatus("Plant: no tiles found.") return end
        local function centers(vals) table.sort(vals) local out={}
            for _,v in ipairs(vals) do if #out==0 or math.abs(v-out[#out])>2 then table.insert(out,v) end end return out end
        local function nearest(list,v) local bi,bd=1,math.huge
            for i,c in ipairs(list) do local d=math.abs(c-v) if d<bd then bd=d bi=i end end return bi end
        local xs,zs={},{} for _,t in ipairs(tiles) do table.insert(xs,t.Position.X) table.insert(zs,t.Position.Z) end
        local xC,zC=centers(xs),centers(zs)
        local numCols,numRows=#xC,#zC
        if numCols==0 or numRows==0 then setStatus("Plant: empty plot grid.") return end
        local FLIP_ROWS,FLIP_COLS=true,true
        local grid={} for r=1,numRows do grid[r]={} end
        for _,t in ipairs(tiles) do
            local ci=nearest(xC,t.Position.X) local ri=nearest(zC,t.Position.Z)
            if FLIP_ROWS then ri=numRows-ri+1 end
            if FLIP_COLS then ci=numCols-ci+1 end
            grid[ri][ci]=t
        end
        local CELL,PAD=28,3
        gridInner.Size=UDim2.fromOffset(numCols*CELL+(numCols-1)*PAD, numRows*CELL+(numRows-1)*PAD)
        local layout=Instance.new("UIGridLayout",gridInner) layout.CellSize=UDim2.fromOffset(CELL,CELL)
        layout.CellPadding=UDim2.fromOffset(PAD,PAD) layout.FillDirectionMaxCells=numCols layout.SortOrder=Enum.SortOrder.LayoutOrder
        local lo=0
        for r=1,numRows do for c=1,numCols do lo=lo+1
            local tile=grid[r][c]
            local btn=Instance.new("TextButton",gridInner) btn.LayoutOrder=lo btn.Text="" btn.BorderSizePixel=0
            btn.AutoButtonColor=false btn.Font=Enum.Font.GothamBold btn.TextSize=12 btn.TextColor3=Color3.new(1,1,1) corner(btn,4)
            local timer=Instance.new("TextLabel",btn) timer.BackgroundTransparency=1 timer.Size=UDim2.new(1,0,1,0)
            timer.Font=Enum.Font.GothamBold timer.TextSize=9 timer.TextColor3=Color3.new(1,1,1) timer.Text=""
            if tile then
                cells[tile]={btn=btn,timer=timer}
                styleCell(tile,btn,plantable(tile))
                btn.MouseButton1Click:Connect(function()
                    if active[tile] then pickupTile(tile) return end
                    if assign[tile] then assign[tile]=nil styleCell(tile,btn,plantable(tile)) updateInfo() return end
                    if not plantable(tile) then return end
                    if not selectedSeed then setStatus("Pick a seed first.") return end
                    if countAssignedTo(selectedSeed.seedName) >= selectedSeed.qty then
                        setStatus("Only "..selectedSeed.qty.." "..selectedSeed.label.." in your bag.") return end
                    assign[tile]=selectedSeed styleCell(tile,btn,false) updateInfo()
                end)
            else
                btn.BackgroundColor3=C.gray
            end
        end end
        updateInfo()
        setStatus(("Plant grid: %dx%d"):format(numRows,numCols))
    end

    local seedDrop=Instance.new("Frame",plantTab) seedDrop.Visible=false seedDrop.BackgroundColor3=C.panel
    seedDrop.BorderSizePixel=0 seedDrop.ZIndex=50 seedDrop.Position=UDim2.fromOffset(0,28) seedDrop.Size=UDim2.fromOffset(200,8) corner(seedDrop,6)
    local sdl=Instance.new("UIListLayout",seedDrop) sdl.Padding=UDim.new(0,2)
    local sdp=Instance.new("UIPadding",seedDrop) sdp.PaddingTop=UDim.new(0,3) sdp.PaddingLeft=UDim.new(0,3) sdp.PaddingRight=UDim.new(0,3) sdp.PaddingBottom=UDim.new(0,3)
    rebuildSeedDrop = function()
        for _,c in ipairs(seedDrop:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
        local seeds=listSeeds()
        if #seeds==0 then
            local none=mkButton(seedDrop,"(no seeds in bag)",C.row,UDim2.new(1,0,0,26),UDim2.new()) none.ZIndex=51 none.AutoButtonColor=false
        else
            for i,s in ipairs(seeds) do
                local opt=mkButton(seedDrop,("%s  x%d"):format(s.label,s.qty),C.row,UDim2.new(1,0,0,26),UDim2.new())
                opt.ZIndex=51 opt.LayoutOrder=i opt.TextXAlignment=Enum.TextXAlignment.Left
                local op=Instance.new("UIPadding",opt) op.PaddingLeft=UDim.new(0,8)
                opt.MouseButton1Click:Connect(function()
                    selectedSeed=s seedBtn.Text="v "..s.label.."  x"..s.qty seedDrop.Visible=false updateInfo()
                    setStatus("Seed: "..s.label.." ("..(growTimeFor(s.seedName) and (fmtT(growTimeFor(s.seedName)).." grow") or "grow time ?")..")")
                end)
            end
        end
        seedDrop.Size=UDim2.fromOffset(200, math.max(8,(#seeds>0 and #seeds or 1)*28+6))
    end
    seedBtn.MouseButton1Click:Connect(function() if not seedDrop.Visible then rebuildSeedDrop() end seedDrop.Visible=not seedDrop.Visible end)

    refreshBtn.MouseButton1Click:Connect(function() rebuildSeedDrop() rebuildGrid() end)
    clearBtn.MouseButton1Click:Connect(function() assign={} refreshCellStyles() updateInfo() setStatus("Cleared queued tiles.") end)
    plantBtn.MouseButton1Click:Connect(function()
        local todo={}
        for tile,seed in pairs(assign) do if plantable(tile) then table.insert(todo,{tile=tile,seed=seed}) end end
        if #todo==0 then setStatus("Nothing queued to plant.") return end
        local capture = { pickup=act.pickup, sell=act.sell, fav=act.fav }
        task.spawn(function()
            local done=0
            for _,e in ipairs(todo) do
                PlantSeed:FireServer(e.seed.seedName, e.seed.colors, tileToPos(e.tile))
                active[e.tile] = { label=e.seed.label, plantedAt=os.clock(), growTime=growTimeFor(e.seed.seedName),
                                   pickup=capture.pickup, sell=capture.sell, fav=capture.fav }
                assign[e.tile]=nil
                done=done+1
                setStatus(("Planting %s %d/%d"):format(e.seed.label,done,#todo))
                task.wait(0.3)
            end
            setStatus(("Planted %d."):format(done))
            task.wait(0.4)
            rebuildSeedDrop() rebuildGrid()
        end)
    end)

    -- grow completion straight from the server: placed plants carry an absolute
    -- "CompletionTime" attribute. This is authoritative and works even when the
    -- registry grow-time lookup misses (which is what had broken auto-pickup).
    local CS2 = game:GetService("CollectionService")
    local function nowTime()
        local ok2,t = pcall(function() return workspace:GetServerTimeNow() end)
        if ok2 and type(t)=="number" and t>1e9 then return t end
        return os.time()
    end
    local function completionAtTile(tile)
        for _,tag in ipairs({"Plants","Plant"}) do
            for _,p in ipairs(CS2:GetTagged(tag)) do
                local ct = tonumber(p:GetAttribute("CompletionTime"))
                if ct and ct>1e9 then
                    local own = p:GetAttribute("Owner")
                    if own==nil or own==LocalPlayer.UserId then
                        local pos
                        if p:IsA("Model") then local ok3,c=pcall(function() return p:GetPivot().Position end) if ok3 then pos=c end
                        elseif p:IsA("BasePart") then pos=p.Position end
                        if pos then
                            local dx,dz = pos.X-tile.Position.X, pos.Z-tile.Position.Z
                            if (dx*dx+dz*dz) < 16 then return ct end
                        end
                    end
                end
            end
        end
        return nil
    end
    task.spawn(function()
        while plantTab.Parent do
            local grown={}
            for tile,a in pairs(active) do
                if a.completion==nil then a.completion = completionAtTile(tile) end
                local rem
                if a.completion then rem = a.completion - nowTime()
                elseif a.growTime then rem = a.growTime-(os.clock()-a.plantedAt)
                else rem = nil end
                local cell=cells[tile]
                if cell and cell.timer then
                    cell.timer.Text = (rem==nil) and "grow" or (rem>0 and fmtT(rem) or "done")
                end
                if rem~=nil and rem<=0 and not a.done then table.insert(grown,{tile=tile,a=a}) end
            end
            for _,g in ipairs(grown) do handleGrown(g.tile,g.a) end
            task.wait(0.5)
        end
    end)

    local prev = onTabShown
    onTabShown = function(name)
        if prev then prev(name) end
        if name=="Plant" then rebuildSeedDrop() rebuildGrid() end
    end
end

