-- resize
local resizing=false; local resizeStartMouse, resizeStartSize
resizeHandle.InputBegan:Connect(function(input)
	if input.UserInputType==Enum.UserInputType.MouseButton1 then
		resizing=true; resizeStartMouse=UIS:GetMouseLocation(); resizeStartSize=frame.AbsoluteSize
	end
end)
UIS.InputEnded:Connect(function(input)
	if input.UserInputType==Enum.UserInputType.MouseButton1 then resizing=false end
end)
UIS.InputChanged:Connect(function(input)
	if resizing and input.UserInputType==Enum.UserInputType.MouseMovement then
		local m=UIS:GetMouseLocation(); local d=m-resizeStartMouse
		local w=math.clamp(resizeStartSize.X+d.X,446,800)
		local h=math.clamp(resizeStartSize.Y+d.Y,220,800)
		frame.Size=UDim2.new(0,w,0,h)
	end
end)

-- drag reorder
local draggingName=nil
local ROW_HEIGHT=34
local ROW_PAD=4
local function moveCoordToIndex(coordName, targetIndex)
	local coords=loadCoords(); local keys=getSortedKeys(coords)
	local cur=table.find(keys,coordName); if not cur then return end
	targetIndex=math.clamp(targetIndex,1,#keys); if cur==targetIndex then return end
	table.remove(keys,cur); table.insert(keys,targetIndex,coordName)
	applyOrders(coords,keys); saveCoords(coords)
end

-- hotkey box recording
local activeHotkeyBox=nil
local function connectHotkeyBox(box, name, field, oldValue)
	box.Focused:Connect(function() activeHotkeyBox=box; box.PlaceholderText="press" end)
	box.FocusLost:Connect(function()
		if activeHotkeyBox==box then activeHotkeyBox=nil end
		local ok=setCoordHotkey(name,field,box.Text)
		if ok then if refreshList then task.defer(refreshList) end else box.Text=oldValue or "" end
	end)
end

UIS.InputBegan:Connect(function(input)
	if input.UserInputType~=Enum.UserInputType.Keyboard then return end
	local focusedBox=UIS:GetFocusedTextBox()
	if activeHotkeyBox and focusedBox==activeHotkeyBox then
		if input.KeyCode==Enum.KeyCode.Backspace or input.KeyCode==Enum.KeyCode.Delete then
			activeHotkeyBox.Text=""; activeHotkeyBox:ReleaseFocus(); return
		end
		if input.KeyCode==Enum.KeyCode.Escape then activeHotkeyBox:ReleaseFocus(); return end
		local combo=comboFromKeyCode(input.KeyCode)
		if combo then activeHotkeyBox.Text=combo; activeHotkeyBox:ReleaseFocus() end
		return
	end
	if focusedBox then return end
	local combo=comboFromKeyCode(input.KeyCode)
	if not combo then return end
	local updName=updHotkeyMap[combo]
	if updName then if updateCoord(updName) and refreshList then refreshList() end return end
	local tpName=tpHotkeyMap[combo]
	if tpName then tpCoord(tpName) end
end)

-- refresh list
refreshList = function()
	local coords=loadCoords()
	local changed=ensureOrders(coords)
	if changed then saveCoords(coords) end
	for _, v in pairs(listFrame:GetChildren()) do if v:IsA("Frame") then v:Destroy() end end
	local keys=getSortedKeys(coords)
	for i, name in ipairs(keys) do
		local data=coords[name]
		local item=Instance.new("Frame", listFrame)
		item.Size=UDim2.new(1,-8,0,ROW_HEIGHT); item.BackgroundColor3=C.row; item.BackgroundTransparency=0.05
		item.BorderSizePixel=0; item.LayoutOrder=data.order or i; corner(item,7)

		local dragBtn=mkButton(item,"=",Color3.fromRGB(60,60,70),UDim2.new(0,22,1,-6),UDim2.new(0,3,0,3))
		dragBtn.Font=Enum.Font.GothamBold; dragBtn.TextSize=14; dragBtn.AutoButtonColor=false; dragBtn.TextColor3=Color3.fromRGB(205,205,215)

		local nameBox=Instance.new("TextBox",item)
		nameBox.Size=UDim2.new(0,80,1,-6); nameBox.Position=UDim2.new(0,30,0,3); nameBox.Text=name
		nameBox.ClearTextOnFocus=false; nameBox.BackgroundColor3=C.field; nameBox.TextColor3=Color3.new(1,1,1)
		nameBox.BorderSizePixel=0; nameBox.Font=Enum.Font.Gotham; nameBox.TextSize=12; corner(nameBox,5)

		local tpKeyBox=Instance.new("TextBox",item)
		tpKeyBox.Size=UDim2.new(0,55,1,-6); tpKeyBox.Position=UDim2.new(0,114,0,3); tpKeyBox.PlaceholderText="TP key"
		tpKeyBox.Text=data.tpHotkey or ""; tpKeyBox.ClearTextOnFocus=false; tpKeyBox.BackgroundColor3=C.field
		tpKeyBox.TextColor3=Color3.new(1,1,1); tpKeyBox.BorderSizePixel=0; tpKeyBox.Font=Enum.Font.Gotham; tpKeyBox.TextSize=11; corner(tpKeyBox,5)

		local updKeyBox=Instance.new("TextBox",item)
		updKeyBox.Size=UDim2.new(0,60,1,-6); updKeyBox.Position=UDim2.new(0,173,0,3); updKeyBox.PlaceholderText="UPD key"
		updKeyBox.Text=data.updHotkey or ""; updKeyBox.ClearTextOnFocus=false; updKeyBox.BackgroundColor3=C.field
		updKeyBox.TextColor3=Color3.new(1,1,1); updKeyBox.BorderSizePixel=0; updKeyBox.Font=Enum.Font.Gotham; updKeyBox.TextSize=11; corner(updKeyBox,5)

		local timerBtn=mkButton(item, data.countdownTimer and "T" or "o",
			data.countdownTimer and C.amber or Color3.fromRGB(64,64,74), UDim2.new(0,24,1,-6), UDim2.new(0,237,0,3))
		timerBtn.Font=Enum.Font.GothamBold; timerBtn.TextSize=12

		local tpBtn=mkButton(item,"TP",C.grey,UDim2.new(0,32,1,-6),UDim2.new(1,-118,0,3))
		local updBtn=mkButton(item,"UPD",Color3.fromRGB(180,120,45),UDim2.new(0,40,1,-6),UDim2.new(1,-82,0,3))
		local delBtn=mkButton(item,"DEL",C.red,UDim2.new(0,36,1,-6),UDim2.new(1,-39,0,3))

		dragBtn.InputBegan:Connect(function(io)
			if io.UserInputType==Enum.UserInputType.MouseButton1 then draggingName=name; dragBtn.Text="^v" end
		end)
		nameBox.FocusLost:Connect(function()
			local newName=trim(nameBox.Text)
			if newName~=name then if renameCoord(name,newName) then refreshList() else nameBox.Text=name end end
		end)
		connectHotkeyBox(tpKeyBox,name,"tpHotkey",data.tpHotkey)
		connectHotkeyBox(updKeyBox,name,"updHotkey",data.updHotkey)
		timerBtn.MouseButton1Click:Connect(function() if toggleCountdownTrigger(name) then refreshList() end end)
		tpBtn.MouseButton1Click:Connect(function() tpCoord(name) end)
		updBtn.MouseButton1Click:Connect(function() if updateCoord(name) then refreshList() end end)
		delBtn.MouseButton1Click:Connect(function() if delCoord(name) then refreshList() end end)
	end
end

UIS.InputChanged:Connect(function(input)
	if draggingName and input.UserInputType==Enum.UserInputType.MouseMovement then
		local mouseY=UIS:GetMouseLocation().Y
		local relativeY=mouseY-listFrame.AbsolutePosition.Y+listFrame.CanvasPosition.Y
		local targetIndex=math.floor(relativeY/(ROW_HEIGHT+ROW_PAD))+1
		moveCoordToIndex(draggingName,targetIndex); refreshList()
	end
end)
UIS.InputEnded:Connect(function(input)
	if input.UserInputType==Enum.UserInputType.MouseButton1 then draggingName=nil end
end)

