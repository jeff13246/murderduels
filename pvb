----------------------------------------------------------------------
--  EVENT TAB  (Investment Week autopilot - one button)
----------------------------------------------------------------------
do
    local Interact = RS:WaitForChild("Remotes"):WaitForChild("Events"):WaitForChild("Investment"):WaitForChild("Interact")
    local ItemSell = RS.Remotes:WaitForChild("ItemSell")
    local FavoriteItem = RS.Remotes:WaitForChild("FavoriteItem")
    local PLANT_NAME = "Cactus"
    local SUBMIT_MAX = 9
    local SELL_KG    = 9.5
    local MAX_KG     = 10
    local COOLDOWN   = 90
    local INVEST_DELAY = 0.10
    local MAX_ERRORS = 15

    local function findEventModel()
        for _,m in ipairs(workspace:GetDescendants()) do
            if m:IsA("Model") and m:FindFirstChild("PlantPrompt") and m:FindFirstChild("MoneyPrompt") then return m end
        end
    end
    local model
    local PlayerData
    pcall(function() PlayerData = require(RS:WaitForChild("PlayerData")) end)

    local function readPlant()
        if PlayerData then
            local ok2,ip = pcall(function() return PlayerData:GetData().Data.InvestmentPlant end)
            if ok2 then
                if ip==nil then return false,0 end
                return true, tonumber(ip.Size) or 0
            end
        end
        local pf = model and model:FindFirstChild("PlantFolder")
        return (pf~=nil and #pf:GetChildren()>0), 0
    end
    local function isPlaced() local p=readPlant() return p end
    local function favorited(id)
        if PlayerData then
            local ok2,fav = pcall(function() return PlayerData:GetData().Data.Favorites end)
            if ok2 and type(fav)=="table" then local f=fav[id] return f~=nil and f~=false end
        end
        return false
    end
    local function claimable()
        if not model then return false end
        for _,d in ipairs(model:GetDescendants()) do
            if (d:IsA("TextLabel") or d:IsA("TextButton")) and type(d.Text)=="string" then
                local t=d.Text:lower()
                if t:find("max investment") or t:find("max size") or t:find("claim your") then return true end
            end
        end
        return false
    end
    local function getFeedTool()
        local best,bsz
        for _,c in ipairs({ LocalPlayer:FindFirstChild("Backpack"), LocalPlayer.Character }) do
            if c then for _,tl in ipairs(c:GetChildren()) do
                if tl:IsA("Tool") and (tl.Name==PLANT_NAME or tl:GetAttribute("PlantName")==PLANT_NAME) then
                    local sz=tonumber(tl:GetAttribute("Size")) or 0
                    if sz<SUBMIT_MAX and (not bsz or sz<bsz) then best,bsz=tl,sz end
                end
            end end
        end
        return best
    end
    local function equip(tool)
        local char=LocalPlayer.Character local hum=char and char:FindFirstChildOfClass("Humanoid")
        if not (tool and hum) then return false end
        hum:EquipTool(tool)
        local t=0 while tool.Parent~=char and t<1 do task.wait(0.03) t+=0.03 end
        return true
    end
    local function ensureFeedEquipped()
        local char=LocalPlayer.Character local held=char and char:FindFirstChildWhichIsA("Tool")
        if held and (held.Name==PLANT_NAME or held:GetAttribute("PlantName")==PLANT_NAME)
           and (tonumber(held:GetAttribute("Size")) or 0)<SUBMIT_MAX then return true end
        return equip(getFeedTool())
    end
    local function sellOutputs()
        for _=1,20 do
            local target
            for _,c in ipairs({ LocalPlayer:FindFirstChild("Backpack"), LocalPlayer.Character }) do
                if c then for _,tl in ipairs(c:GetChildren()) do
                    if tl:IsA("Tool") and (tl.Name==PLANT_NAME or tl:GetAttribute("PlantName")==PLANT_NAME) then
                        if (tonumber(tl:GetAttribute("Size")) or 0) >= SELL_KG then target=tl break end
                    end
                end end
                if target then break end
            end
            if not target then break end
            local id=target:GetAttribute("ID")
            for _=1,3 do
                if id and favorited(id) then FavoriteItem:FireServer(id) task.wait(0.2) else break end
            end
            if equip(target) then
                ItemSell:FireServer(true) task.wait(0.25)
                local hum=LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                if hum then pcall(function() hum:UnequipTools() end) end
            end
            task.wait(0.15)
            if target.Parent then break end
        end
    end
    local function closeResetPopup()
        local pg=LocalPlayer:FindFirstChild("PlayerGui") if not pg then return end
        for _,lbl in ipairs(pg:GetDescendants()) do
            if lbl:IsA("TextLabel") and type(lbl.Text)=="string" and lbl.Text:lower():find("reset event") then
                local f=lbl while f and f.Parent and not f.Parent:IsA("ScreenGui") do f=f.Parent end
                if f then pcall(function() f.Visible=false end) end return
            end
        end
    end

    local resetWanted,consecErrors=false,0
    Interact.OnClientEvent:Connect(function(action)
        if action=="ResetPrompt" then resetWanted=true
        elseif action=="Grow" then consecErrors=0
        elseif action=="Error" then consecErrors+=1 end
    end)

    local function claimAndSell()
        Interact:FireServer("AttemptPickupPlant")
        local t=0
        while isPlaced() and t<5 do
            task.wait(0.25) t+=0.25
            if t==1.5 and isPlaced() then Interact:FireServer("AttemptPickupPlant") end
        end
        consecErrors=0
        task.wait(0.3)
        sellOutputs()
        setStatus("event: claimed + sold output")
    end

    local function loop()
        model = findEventModel()
        if not model then setStatus("event: booth not found (active?)") getgenv().InvestRun=false return end
        local cooldownUntil,lastPlaced=0,false
        while getgenv().InvestRun do
            local placed,size=readPlant()
            if (not placed) and lastPlaced then cooldownUntil=os.clock()+COOLDOWN end
            lastPlaced=placed
            if placed then
                if size>=MAX_KG-0.1 or claimable() then claimAndSell()
                elseif resetWanted then
                    Interact:FireServer("Reset") task.wait(0.15) closeResetPopup()
                    resetWanted=false consecErrors=0 setStatus("event: round full - reset")
                elseif consecErrors>=MAX_ERRORS then claimAndSell()
                else Interact:FireServer("IncrementMoney") task.wait(INVEST_DELAY) end
            else
                if os.clock()<cooldownUntil then task.wait(1)
                elseif ensureFeedEquipped() then Interact:FireServer("AttemptAddPlant") task.wait(1.5)
                else setStatus("event: no small '"..PLANT_NAME.."' to feed") task.wait(3) end
            end
        end
        setStatus("event: stopped")
    end

    mkLabel(eventTab,"Investment Week",UDim2.new(1,0,0,18),UDim2.new(),C.txt,Enum.Font.GothamBold,14)
    local startBtn=mkButton(eventTab,"Start",C.green,UDim2.fromOffset(120,30),UDim2.fromOffset(0,28))
    local running=false
    startBtn.MouseButton1Click:Connect(function()
        running=not running
        if running then
            startBtn.Text="Stop" startBtn.BackgroundColor3=C.red
            getgenv().InvestRun=true setStatus("event: running")
            task.spawn(loop)
        else
            startBtn.Text="Start" startBtn.BackgroundColor3=C.green
            getgenv().InvestRun=false
        end
    end)
    mkLabel(eventTab,"Feeds the smallest Cactus, maxes it, claims, sells the 10kg output, repeats on the 90s cooldown. Off by default; temporary event tab.",
        UDim2.new(1,0,0,70),UDim2.fromOffset(0,66),C.dim,Enum.Font.Gotham,11).TextWrapped=true
end

