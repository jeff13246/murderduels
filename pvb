loadCoords(); rebuildHotkeys(); refreshList(); updateCountdownLabel()

getgenv().Coords = {
	add = function() if addCoord() then refreshList() end end,
	tp = tpCoord,
	update = function(name) if updateCoord(name) then refreshList() end end,
	remove = function(name) if delCoord(name) then refreshList() end end,
	rename = function(o,n) if renameCoord(o,n) then refreshList() end end,
	tpHotkey = function(name,key) if setCoordHotkey(name,"tpHotkey",key) then refreshList() end end,
	updateHotkey = function(name,key) if setCoordHotkey(name,"updHotkey",key) then refreshList() end end,
	timer = function(name) if toggleCountdownTrigger(name) then refreshList() end end,
	list = listCoords,
	refresh = function() rebuildHotkeys(); refreshList() end,
	setPack = function(i) if PACK_TYPES[i] then selectedPack=i; packBtn.Text="v "..PACK_TYPES[i].label end end,
	stopOpen = function() stopSuppressor() print("suppressor stopped (popups re-enabled)") end,
	openCards = function() openCards(print) end,
	deleteCards = function() deleteCards(print) end,
	instantPrompts = function() for _, obj in ipairs(game:GetDescendants()) do makePromptInstant(obj) end print("re-applied instant prompts") end,
}

